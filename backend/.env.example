# ZipGenie(집보미) — 환경 변수 (.gitignore 대상)

# Gemini (부동산 관련도 채점·노트 초안·주간 흐름·질문하기) — 콤마로 여러 개 넣으면 로테이션
GEMINI_API_KEYS=

# 네이버 뉴스 검색 API (없으면 네이버 수집만 건너뜀)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털(data.go.kr) 인증키 — 국토교통부 아파트 매매 실거래가 조회(/deals). 비우면 안내 화면만 보임
DATA_GO_KR_KEY=

# 뉴스레터 메일 발송 (SMTP) — 비어 있으면 발송 기능만 꺼짐
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# starttls / ssl / none
SMTP_TLS=starttls

# 메일 안 링크(노트·구독 해지)에 쓰는 사이트 주소
SITE_URL=http://localhost:5030

# Databricks 적재 (선택 — 비우면 꺼짐)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# 이 프로젝트 전용 Databricks 스키마 (다른 서비스와 섞이지 않게)
DATABRICKS_SCHEMA=zipgenie
# 관리자 로그인 토큰 (운영 필수 — 40자 이상 무작위 값). 관리 화면에서 한 번 넣으면 세션 쿠키로 로그인
ADMIN_TOKEN=
# 관리자 OTP 비밀값 (권장) — venv\Scripts\python tools\admin_otp.py 로 만들어 OTP 앱에 등록. 넣으면 OTP 필수
ADMIN_TOTP_SECRET=

# 한국은행 ECOS 오픈API 인증키 (기준금리·주담대 금리·KB 지수·심리지수·가계대출). 비우면 공개 sample 키(요청당 10건)로 동작
ECOS_API_KEY=

# 수집·발송 실패 경보를 받을 관리자 메일 (비우면 경보 메일 안 보냄)
ALERT_EMAIL=

# Claude 키 (선택 — 관리 > AI 모델 설정에서 넣어도 됨, 그 값은 data/llm_keys.json 에 저장)
ANTHROPIC_API_KEY=

# Databricks 카탈로그 (선택, 기본 workspace)
DATABRICKS_CATALOG=

# 카카오 JavaScript 키 (선택 — 카카오 공유 + 지도 화면 안 카카오맵. 카카오 개발자 사이트에 도메인 등록), Reddit 수집 (선택)
KAKAO_JS_KEY=
# 지도 화면 안에 그릴 지도 키 (선택 — 비우면 단추가 그 회사 지도 새 창으로 열림)
# 네이버 클라우드 Maps Client ID (뉴스 검색용 NAVER_CLIENT_ID 와 다름), 구글 Maps JavaScript API 키
NAVER_MAP_CLIENT_ID=
GOOGLE_MAPS_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 서버 실행 옵션 (보통 start-zipbomi.bat 이 정한다)
# ZIPGENIE_PORT=5030
# ZIPGENIE_HOST=127.0.0.1
# ZIPGENIE_SCHEDULER=1
# ZIPGENIE_WORKERS=1
# ZIPGENIE_DB=            (비우면 backend/data/zipbomi.db)
